{
    "name": "pdmfc/pdf-gallery",
    "description": "Laravel package for PDF gallery, preview, merge and print (Inertia + Vue 3)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "PDMFC",
            "email": "miguel.goncalves@pdmfc.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^10.0|^11.0",
        "inertiajs/inertia-laravel": "^0.6.3|^1.0|^2.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.22",
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "PDMFC\\PdfGallery\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PDMFC\\PdfGallery\\Providers\\PdfGalleryServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
