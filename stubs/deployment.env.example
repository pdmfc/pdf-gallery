# Kubernetes / OpenShift (ConfigMap ou Deployment env)
PDF_GALLERY_QPDF_BINARY=/usr/bin/qpdf
PDF_GALLERY_GHOSTSCRIPT_BINARY=/usr/bin/gs
PDF_GALLERY_MERGE_ENGINES=qpdf,ghostscript,fpdi
# PDF_GALLERY_BINARY_SEARCH_PATHS=/usr/bin,/bin

# Desenvolvimento local (Mac/Linux) — omita PDF_GALLERY_*_BINARY para auto-detecção
# brew install qpdf ghostscript

# Verificar dependências:
# php artisan pdf-gallery:check-tools

# QR Code (upload-files-api) — callback configurável
# PDF_GALLERY_QRCODE_URL=https://api-qr.exemplo/qrcode
# PDF_GALLERY_QRCODE_API_TOKEN=seu-token
# PDF_GALLERY_QRCODE_DELIVERY_MODE=callback_base64
# PDF_GALLERY_QRCODE_CALLBACK_URL=https://seu-dominio.test/callback/upload-draft-attachments/{draftId}
# PDF_GALLERY_CALLBACK_PATH=callback/upload-draft-attachments/{draftId}
# PDF_GALLERY_CALLBACK_SCOPE_PARAM=draftId
# PDF_GALLERY_CALLBACK_SCOPE_CONSTRAINT=uuid
# PDF_GALLERY_CALLBACK_MIDDLEWARE=api
# PDF_GALLERY_QR_CODE_ENABLED=true
# PDF_GALLERY_CONVERT_ENABLED=true
# PDF_GALLERY_CONVERT_ENGINES=ghostscript,libreoffice,gotenberg
# PDF_GALLERY_CONVERT_IMAGE_ENGINES=fpdf,ghostscript
# PDF_GALLERY_CONVERT_WORD_ENGINES=libreoffice,gotenberg
# PDF_GALLERY_LIBREOFFICE_BINARY=/usr/bin/soffice
# PDF_GALLERY_GOTENBERG_URL=http://gotenberg:3000
# PDF_GALLERY_CONVERT_TIMEOUT=120
